# /etc/s3-gateway/webadmin.env  (root:root 600, created by install-webadmin.sh)
S3_WEBADMIN_HOST=0.0.0.0
S3_WEBADMIN_PORT=8080
# Generate with: /opt/s3-gateway/app/.venv/bin/python -m webadmin.hashpw
S3_WEBADMIN_PASSWORD_HASH=
# Random string that signs login cookies (installer generates one)
S3_WEBADMIN_SECRET_KEY=
S3_SERVICE_NAME=s3-zigbee-gateway
