# /etc/s3-gateway/webadmin.env  (root:root 600, created by install-webadmin.sh)
S3_WEBADMIN_HOST=0.0.0.0
S3_WEBADMIN_PORT=8080
# Generate with: /opt/s3-gateway/app/.venv/bin/python -m webadmin.hashpw
S3_WEBADMIN_PASSWORD_HASH=
# Random string that signs login cookies (installer generates one)
S3_WEBADMIN_SECRET_KEY=
S3_SERVICE_NAME=s3-zigbee-gateway
# --- Serial page ---
# Node controls talk to the running gateway's REST server:
# S3_GATEWAY_API=http://127.0.0.1:9090
# Direct console (raw commands, pauses the gateway while open). Set by
# `sudo env S3_ENABLE_SERIAL_CONSOLE=1 scripts/install-webadmin.sh`, which also adds the sudo rule.
# S3_SERIAL_CONSOLE=0
# S3_SERIAL_PORT=auto            # or a fixed device such as /dev/ttyUSB0
# S3_SERIAL_IDLE_SECONDS=600     # closes the port and restarts the gateway after this much inactivity
